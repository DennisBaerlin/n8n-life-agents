# .env.example - copy to .env (gitignored), then fill in the values. Secrets NEVER go into the
# repo (root CLAUDE.md "Credentials-Policy"). This template holds only the key names + format
# hints, no values. The single source of truth for the env layout (no second template).
#
# NOTE: there is no live REST/DB sync target (hence no N8N_URL/PG_* keys). The automated test tiers
# run against the ephemeral Docker substrate (scripts/dev/bootstrap_test_n8n.ps1); the hands-on
# install test runs on a real LXC dev instance (DEV_INSTANCE_* below, scripts/reset_dev_instance.ps1).

# --- Dev instance (scripts/reset_dev_instance.ps1) ---------------------------
# Real LXC in the LAN for the hands-on CLI install test (wiped + re-staged per iteration). SSH
# key-login only. DEV_INSTANCE_HOST = hostname of the container (keep it out of tracked files),
# DEV_INSTANCE_USER defaults to root (provision.sh needs root), DEV_INSTANCE_SSH_KEY = private key path (~ ok).
DEV_INSTANCE_HOST=
DEV_INSTANCE_USER=
DEV_INSTANCE_SSH_KEY=

# --- Owner identity (author toolchain) --------------------------------------
# OWNER_CHAT_ID: your numeric Telegram chat_id. build.ps1 reads it ONLY to redact it from the
# tracked workflows (placeholder __OWNER_CHAT_ID__) -> no PII in packages/*/workflows/. The substrate gets
# it via TEST_TELEGRAM_CHAT_ID->OWNER_CHAT_ID; a real prod gets it via provision.sh (self-healing).
OWNER_CHAT_ID=

# --- LLM key (local scripts: judge_eval runs on Claude Haiku via the Anthropic API) ---------
ANTHROPIC_API_KEY=

# --- Test harness (LLM suites / infra_test): the secret value of the Header-Auth credential.
#     The credential itself is created by inject_credentials.sh from this secret (header name
#     X-Test-Auth); the workflows reference it via the __CRED_HARNESS__ placeholder, so no id needed. --
TEST_HARNESS_SECRET=

# ============================================================================
# Docker test substrate (scripts/dev/bootstrap_test_n8n.ps1) - the n8n integration
# tiers run against an ephemeral systemd-Docker container, not prod. These TEST_*
# values are injected as the in-container install env (mapped to the core env names
# provision.sh/bootstrap_owner.sh/inject_credentials.sh read); missing optional ones are
# auto-generated or skip the matching step cleanly. TEST_HARNESS_SECRET (above) is the
# harness header-auth value; its header name X-Test-Auth is set by the driver.
# ============================================================================
# Separate TEST bot (orchestrator/pairing path; the tiers themselves use the harness
# webhooks, not Telegram) ----------------------------------------------------
TEST_TELEGRAM_BOT_TOKEN=
TEST_TELEGRAM_CHAT_ID=
# ^ a dedicated BotFather bot + your numeric chat_id (NOT the prod bot!)

# Owner identity for the test person skeleton (else no pairing code is issued) -
TEST_OWNER_FIRST_NAME=
TEST_OWNER_LAST_NAME=
TEST_OWNER_BIRTH_DATE=
# ^ e.g. 1990-05-01 (YYYY-MM-DD)
TEST_OWNER_LANGUAGE=
# ^ language of the bot's fixed texts for the test owner: de|en|ko (empty = de)

# LLM keys of the substrate: TEST_ANTHROPIC_API_KEY is REQUIRED for the agent tiers (all chat agents run on
# Claude; the credential points to the local LLM gateway — paid suites + llm_gateway_test need a real key, the
# mock tier does not). TEST_GOOGLE_API_KEY is optional (only voice-message
# transcription; missing -> no Google credential, voice messages take the friendly voice_unavailable path).
TEST_ANTHROPIC_API_KEY=
TEST_GOOGLE_API_KEY=
# Optional test secrets (missing -> the matching credential/step is skipped cleanly)
# Career WS-2 job sources (optional; missing -> that source is skipped, only Bundesagentur runs).
# Map to the env keys DECLARED in packages/career/manifest.json `credentials` (docs/package-contract.md
# §3.8); the substrate passes them as process env, prod persists them in /etc/lifeagents/career.env
# (stage-4 wizard / lifeagents package reconfigure career - NOT core.env anymore).
# Adzuna: free developer account (developer.adzuna.com) -> app_id + app_key. JSearch: RapidAPI key
# (rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch, free BASIC tier). Adzuna surfaces StepStone, JSearch LinkedIn.
TEST_ADZUNA_APP_ID=
TEST_ADZUNA_APP_KEY=
TEST_JSEARCH_API_KEY=
# Paperless (paperless package, credential 'Paperless-NGX API'): the API token of a READ-ONLY Paperless user
# (profile -> API auth token). In the substrate ANY value works - scripts/dev/enable_mock_paperless.ps1 points the
# tools at a local mock and swaps the token for the mock token (the real token never reaches the mock).
TEST_PAPERLESS_API_TOKEN=
TEST_N8N_OWNER_EMAIL=
TEST_N8N_OWNER_PASSWORD=
# ^ n8n password policy: 8-64 chars, >=1 digit, >=1 uppercase letter.

# First-init overrides (else auto-generated): n8n encryption key + n8n DB password.
TEST_N8N_ENCRYPTION_KEY=
TEST_PG_PASSWORD=

# Optional: N8NTEST_PORT pins the host port for the socat bridge (default 5680).
