{
  "$description": "Eine Farbquelle aller Oberflächen, Format DTCG 2025.10. Blöcke: scripts/build_ui_tokens.ps1, Prüfung: scripts/ui_token_lint.ps1, Regeln: docs/reference/ui.md.",
  "light": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.0902, 0.1294, 0.1686], "hex": "#17212B" }, "$description": "Text und Überschriften auf bg und bg-soft; Fläche des Hauptknopfs." },
    "gray": { "$value": { "colorSpace": "srgb", "components": [0.3333, 0.3882, 0.4314], "hex": "#55636E" }, "$description": "Nebentext." },
    "hairline": { "$value": { "colorSpace": "srgb", "components": [0.8863, 0.9059, 0.9255], "hex": "#E2E7EC" }, "$description": "Trennlinien, Rahmen von Karten und Navigation. Für Eingabefelder zu schwach, dort gray." },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.0706, 0.3882, 0.5412], "hex": "#12638A" }, "$description": "Links, Akzentwort, Listenpunkte, Rand von Zitaten, Status läuft." },
    "accent-hover": { "$value": { "colorSpace": "srgb", "components": [0.051, 0.302, 0.4235], "hex": "#0D4D6C" }, "$description": "Link beim Überfahren." },
    "accent-mid": { "$value": { "colorSpace": "srgb", "components": [0.6588, 0.8275, 0.902], "hex": "#A8D3E6" }, "$description": "Rahmen hervorgehobener Chips und gewählter Antworten; Hover des weichen Knopfs. Nicht für Text." },
    "accent-pale": { "$value": { "colorSpace": "srgb", "components": [0.8627, 0.9412, 0.9725], "hex": "#DCF0F8" }, "$description": "Fläche für Eyebrow, weichen Knopf, Häkchen und aktive Navigation; Text darauf ink." },
    "accent-wash": { "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9725, 0.9843], "hex": "#F1F8FB" }, "$description": "Fläche von Hinweisen und Zitaten; Text darauf ink." },
    "code-wash": { "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9725, 0.9843], "hex": "#F1F8FB" }, "$description": "Fläche für Inline-Code." },
    "ok": { "$value": { "colorSpace": "srgb", "components": [0.1176, 0.6196, 0.4157], "hex": "#1E9E6A" }, "$description": "Alles in Ordnung. Nur als Fläche oder Punkt, nie als Text." },
    "warn": { "$value": { "colorSpace": "srgb", "components": [0.8, 0.5255, 0], "hex": "#CC8600" }, "$description": "Warnung. Nur als Fläche oder Punkt, nie als Text." },
    "warn-wash": { "$value": { "colorSpace": "srgb", "components": [0.9922, 0.9529, 0.8471], "hex": "#FDF3D8" }, "$description": "Fläche von Warnhinweisen; Text darauf ink." },
    "alert": { "$value": { "colorSpace": "srgb", "components": [0.8235, 0.2471, 0.2667], "hex": "#D23F44" }, "$description": "Fehler. Als Punkt oder Rand; Text in ink." },
    "alert-wash": { "$value": { "colorSpace": "srgb", "components": [0.9922, 0.9098, 0.9098], "hex": "#FDE8E8" }, "$description": "Fläche von Fehlerhinweisen; Text darauf ink." },
    "kid": { "$value": { "colorSpace": "srgb", "components": [0.4784, 0.3529, 0.9725], "hex": "#7A5AF8" }, "$description": "Streifen an Zeilen, die Kindern gehören. Nur als Streifen, nie als Text." },
    "bg": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" }, "$description": "Seitenflaeche, Karten." },
    "bg-soft": { "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9725, 0.9843], "hex": "#F1F8FB" }, "$description": "Bänder, Fußzeile, Codeblöcke, Tabellenkopf; hebt sich leicht von bg ab." }
  },
  "dark": {
    "$type": "color",
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.9333, 0.9529, 0.9647], "hex": "#EEF3F6" }, "$description": "Text und Überschriften auf bg und bg-soft; Fläche des Hauptknopfs." },
    "gray": { "$value": { "colorSpace": "srgb", "components": [0.6353, 0.6941, 0.7373], "hex": "#A2B1BC" }, "$description": "Nebentext." },
    "hairline": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.2039, 0.2353], "hex": "#2A343C" }, "$description": "Trennlinien, Rahmen von Karten und Navigation. Für Eingabefelder zu schwach, dort gray." },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.3647, 0.7176, 0.8667], "hex": "#5DB7DD" }, "$description": "Links, Akzentwort, Listenpunkte, Rand von Zitaten, Status läuft." },
    "accent-hover": { "$value": { "colorSpace": "srgb", "components": [0.6588, 0.8275, 0.902], "hex": "#A8D3E6" }, "$description": "Link beim Überfahren." },
    "accent-mid": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.3529, 0.4392], "hex": "#2A5A70" }, "$description": "Rahmen hervorgehobener Chips und gewählter Antworten; Hover des weichen Knopfs. Nicht für Text." },
    "accent-pale": { "$value": { "colorSpace": "srgb", "components": [0.0941, 0.2275, 0.2902], "hex": "#183A4A" }, "$description": "Fläche für Eyebrow, weichen Knopf, Häkchen und aktive Navigation; Text darauf ink." },
    "accent-wash": { "$value": { "colorSpace": "srgb", "components": [0.1059, 0.1373, 0.1608], "hex": "#1B2329" }, "$description": "Fläche von Hinweisen und Zitaten; Text darauf ink." },
    "code-wash": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.2039, 0.2353], "hex": "#2A343C" }, "$description": "Fläche für Inline-Code." },
    "ok": { "$value": { "colorSpace": "srgb", "components": [0.2353, 0.7529, 0.549], "hex": "#3CC08C" }, "$description": "Alles in Ordnung. Nur als Fläche oder Punkt, nie als Text." },
    "warn": { "$value": { "colorSpace": "srgb", "components": [0.8784, 0.6275, 0.1882], "hex": "#E0A030" }, "$description": "Warnung. Nur als Fläche oder Punkt, nie als Text." },
    "warn-wash": { "$value": { "colorSpace": "srgb", "components": [0.2275, 0.1804, 0.0627], "hex": "#3A2E10" }, "$description": "Fläche von Warnhinweisen; Text darauf ink." },
    "alert": { "$value": { "colorSpace": "srgb", "components": [0.898, 0.3765, 0.3725], "hex": "#E5605F" }, "$description": "Fehler. Als Punkt oder Rand; Text in ink." },
    "alert-wash": { "$value": { "colorSpace": "srgb", "components": [0.2392, 0.1216, 0.1255], "hex": "#3D1F20" }, "$description": "Fläche von Fehlerhinweisen; Text darauf ink." },
    "kid": { "$value": { "colorSpace": "srgb", "components": [0.6431, 0.5412, 0.9843], "hex": "#A48AFB" }, "$description": "Streifen an Zeilen, die Kindern gehören. Nur als Streifen, nie als Text." },
    "bg": { "$value": { "colorSpace": "srgb", "components": [0.0706, 0.0941, 0.1137], "hex": "#12181D" }, "$description": "Seitenflaeche, Karten." },
    "bg-soft": { "$value": { "colorSpace": "srgb", "components": [0.1059, 0.1373, 0.1608], "hex": "#1B2329" }, "$description": "Bänder, Fußzeile, Codeblöcke, Tabellenkopf; hebt sich leicht von bg ab." }
  },
  "shape": {
    "radius-xs": { "$type": "dimension", "$value": { "value": 6, "unit": "px" }, "$description": "Inline-Code." },
    "radius-sm": { "$type": "dimension", "$value": { "value": 10, "unit": "px" }, "$description": "Navigationszeilen." },
    "radius-md": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "Icon-Flächen." },
    "radius": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "Karten, Hinweise, Tabellen, Codeblöcke. Das Hauptmaß." },
    "radius-pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" }, "$description": "Knöpfe, Eyebrow, Chips." },
    "font": { "$type": "fontFamily", "$value": ["-apple-system", "Segoe UI", "system-ui", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Systemschrift, keine Schriftdatei und kein CDN." },
    "font-mono": { "$type": "fontFamily", "$value": ["ui-monospace", "Cascadia Code", "Consolas", "monospace"], "$description": "Code." }
  },
  "$extensions": {
    "dev.lifeagents.contrast": [
      { "fg": "ink", "bg": "bg", "min": 4.5, "use": "Text" },
      { "fg": "ink", "bg": "bg-soft", "min": 4.5, "use": "Text" },
      { "fg": "gray", "bg": "bg", "min": 4.5, "use": "Nebentext" },
      { "fg": "gray", "bg": "bg-soft", "min": 4.5, "use": "Nebentext in Fußzeile und Bändern" },
      { "fg": "accent", "bg": "bg", "min": 4.5, "use": "Links" },
      { "fg": "accent", "bg": "bg-soft", "min": 4.5, "use": "Links in Fußzeile und Bändern" },
      { "fg": "accent-hover", "bg": "bg", "min": 4.5, "use": "Link beim Überfahren" },
      { "fg": "bg", "bg": "ink", "min": 4.5, "use": "Schrift des Hauptknopfs" },
      { "fg": "ink", "bg": "accent-pale", "min": 4.5, "use": "Text auf Akzentflaeche" },
      { "fg": "ink", "bg": "accent-mid", "min": 4.5, "use": "Text auf weichem Knopf beim Überfahren" },
      { "fg": "ink", "bg": "accent-wash", "min": 4.5, "use": "Text in Hinweisen" },
      { "fg": "ink", "bg": "code-wash", "min": 4.5, "use": "Inline-Code" },
      { "fg": "ink", "bg": "warn-wash", "min": 4.5, "use": "Text in Warnhinweisen" },
      { "fg": "ink", "bg": "alert-wash", "min": 4.5, "use": "Text in Fehlerhinweisen" },
      { "fg": "accent", "bg": "bg", "min": 3, "use": "Status-Punkt läuft" },
      { "fg": "ok", "bg": "bg", "min": 3, "use": "Punkt und Rand von Alles in Ordnung" },
      { "fg": "warn", "bg": "bg", "min": 3, "use": "Warn-Punkt und Rand" },
      { "fg": "alert", "bg": "bg", "min": 3, "use": "Fehler-Punkt und Rand" },
      { "fg": "kid", "bg": "bg", "min": 3, "use": "Streifen an Kinder-Zeilen" }
    ]
  }
}
