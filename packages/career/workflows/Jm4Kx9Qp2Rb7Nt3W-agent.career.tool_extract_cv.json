                  {
                      "parameters":  {
                                         "jsCode":  "const anthropicText = (r) =\u003e {\n  if (!r || !Array.isArray(r.content)) {\n    const m = (r \u0026\u0026 r.error \u0026\u0026 (r.error.message || r.error.type || r.error.description)) || \u0027no response\u0027;\n    return { ok: false, error: String(m).slice(0, 200) };\n  }\n  if (r.stop_reason === \u0027max_tokens\u0027) return { ok: false, error: \u0027answer truncated (max_tokens)\u0027 };\n  if (r.stop_reason === \u0027refusal\u0027) return { ok: false, error: \u0027model declined the request\u0027 };\n  if (r.stop_reason === \u0027pause_turn\u0027) return { ok: false, error: \u0027web search did not finish (pause_turn)\u0027 };\n  const text = r.content.filter(b =\u003e b \u0026\u0026 b.type === \u0027text\u0027 \u0026\u0026 b.text).map(b =\u003e b.text).join(\u0027\u0027).trim();\n  if (!text) return { ok: false, error: \u0027empty answer\u0027 };\n  return { ok: true, text };\n};\nconst stripFences = (t) =\u003e String(t).replace(/^\\s*```[a-z]*\\s*/i, \u0027\u0027).replace(/\\s*```\\s*$/, \u0027\u0027);const r = $input.first().json;\nconst fail = (m) =\u003e [{ json: { ok: false, error: \u0027CV extraction failed (\u0027 + m + \u0027) - ask the user for a sharper photo or to dictate the facts instead.\u0027 } }];\nconst res = anthropicText(r);\nif (!res.ok) return fail(res.error);\nconst txt = stripFences(res.text);\nconst a = txt.indexOf(\u0027{\u0027), z = txt.lastIndexOf(\u0027}\u0027);\nlet prof;\ntry { prof = JSON.parse(a \u003e= 0 \u0026\u0026 z \u003e a ? txt.slice(a, z + 1) : txt); }\ncatch (e) { return fail(\u0027unparseable model output\u0027); }\nif (!prof || typeof prof !== \u0027object\u0027 || Array.isArray(prof)) return fail(\u0027model did not return an object\u0027);\nconst ids = $(\u0027Collect files\u0027).first().json.file_ids;\nconst ignored_files = (Array.isArray(prof.ignored_files) ? prof.ignored_files : []).map((n) =\u003e ids[Number(n) - 1]).filter(Boolean);\ndelete prof.ignored_files;\nif (Array.isArray(prof.skills)) prof.skills = prof.skills.slice(0, 20).filter(s =\u003e s \u0026\u0026 typeof s === \u0027object\u0027 \u0026\u0026 s.name);\nconst keys = Object.keys(prof).filter(k =\u003e prof[k] !== null \u0026\u0026 prof[k] !== \u0027\u0027 \u0026\u0026 !(Array.isArray(prof[k]) \u0026\u0026 prof[k].length === 0));\nif (keys.length === 0) return [{ json: { ok: false, error: \u0027No CV data recognized - is this really a CV/resume? Ask the user, then capture by asking if needed.\u0027 } }];\nreturn [{ json: { ok: true, profile: JSON.stringify(prof), field_count: keys.length, ignored_files } }];"
