                  {
                      "parameters":  {
                                         "jsCode":  "const list = $(\u0027List files\u0027).all().map((i) =\u003e i.json);\nconst got = $input.all().map((i) =\u003e i.json);\nconst out = (json) =\u003e [{ json, pairedItem: { item: 0 } }];\nconst no = (error, mime, failed) =\u003e out({ ok: false, error, mime: mime || \u0027\u0027, failed_file_id: failed || \u0027\u0027, file_count: list.length, file_ids: [] });\nif (list[0].error) return no(list[0].error);\nif (got.length !== list.length) return no(\u0027Only \u0027 + got.length + \u0027 of \u0027 + list.length + \u0027 files could be fetched - ask the user to send them again.\u0027);\nconst bad = got.findIndex((f) =\u003e !f.ok);\nif (bad \u003e= 0) {\n  const others = list.length \u003e 1 ? \u0027File \u0027 + list[bad].file_id + \u0027: \u0027 : \u0027\u0027;\n  const next = list.length \u003e 1 ? \u0027 Nothing was read - call this tool again without this file_id.\u0027 : \u0027\u0027;\n  return no(others + got[bad].error + next, got[bad].mime, list[bad].file_id);\n}\nif (got.reduce((sum, f) =\u003e sum + String(f.b64 || \u0027\u0027).length, 0) \u003e 30 * 1024 * 1024) return no(\u0027These files are too large together - call this tool in smaller groups of files.\u0027);\nreturn out({ ok: true, error: \u0027\u0027, mime: \u0027\u0027, failed_file_id: \u0027\u0027, file_count: list.length, file_ids: list.map((f) =\u003e f.file_id) });"
