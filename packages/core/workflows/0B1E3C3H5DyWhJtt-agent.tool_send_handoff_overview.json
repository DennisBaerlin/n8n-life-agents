                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "function uiRender(B, LANGS) {\n  B = B || {};\n  LANGS = LANGS || {};\n  const T = B.t || {};\n  const loc = B.locale || \u0027en-GB\u0027;\n  // fn_ui_texts liefert fuer einen fehlenden Key den Key selbst -\u003e das zaehlt hier als \"nicht vorhanden\".\n  const has = (k) =\u003e Object.prototype.hasOwnProperty.call(T, k) \u0026\u0026 T[k] !== k;\n  const t = (k) =\u003e (has(k) ? T[k] : String(k));\n  const empty = has(\u0027core.fmt.empty\u0027) ? T[\u0027core.fmt.empty\u0027] : \u0027—\u0027;\n  const isEmpty = (v) =\u003e v === null || v === undefined || v === \u0027\u0027;\n  // Platzhalter in EINEM Durchlauf: einfache Werte unveraendert (auch \u0027\u0027 fuer optionale Zusaetze wie die Einheit),\n  // nur typisierte Werte ({kind: money|date|enum|...}) laufen durch val(); null/undefined -\u003e \u0027\u0027. Ein FEHLENDER\n  // Parameter zaehlt wie undefined: n8n verwirft undefined-Felder beim Speichern des Summary-Objekts, sonst stuende\n  // Rohtext wie \"{isin}\" auf der Karte (Owner 2026-10-22). Vertippte Parameter-Namen faengt der Build\n  // (Assert-HitlTplParams in New-HitlLine/New-HitlNote/New-HitlSummary).\n  function fill(txt, params) {\n    return String(txt).replace(/\\{(\\w+)\\}/g, (m, n) =\u003e {\n      if (!params || !Object.prototype.hasOwnProperty.call(params, n)) return \u0027\u0027;\n      const p = params[n];\n      if (p === null || p === undefined) return \u0027\u0027;\n      return (typeof p === \u0027object\u0027) ? val(p) : String(p);\n    });\n  }\n  // sign = true (core.fn_ui_money p_sign): \u0027+\u0027 vor positive Betraege (Gewinn seit Kauf); negative tragen ihr Minus ohnehin.\n  // digits = 0 (core.fn_ui_money p_whole): ganze Einheiten fuer Schaetzwerte; der Wert selbst bleibt genau (gerundet nur hier).\n  function money(v, c, sign, digits) {\n    if (isEmpty(v)) return empty;\n    const n = Number(v);\n    if (!isFinite(n)) return String(v);\n    const plus = (sign === true \u0026\u0026 n \u003e 0) ? \u0027+\u0027 : \u0027\u0027;\n    // Ohne gueltigen Waehrungscode KEIN stilles EUR (ein USD-Betrag sahe sonst wie Euro aus): Zahl + Rohcode.\n    const whole = (digits === 0);\n    if (!(typeof c === \u0027string\u0027 \u0026\u0026 /^[A-Za-z]{3}$/.test(c))) return plus + num(v, whole ? 0 : 2) + (isEmpty(c) ? \u0027\u0027 : \u0027 \u0027 + String(c));\n    const cur = c.toUpperCase();\n    try { return plus + (whole ? Number(n).toLocaleString(loc,{style:\u0027currency\u0027,currency:(/^[A-Za-z]{3}$/.test(cur)?cur:\u0027EUR\u0027),currencyDisplay:\u0027narrowSymbol\u0027,minimumFractionDigits:0,maximumFractionDigits:0}) : Number(n).toLocaleString(loc,{style:\u0027currency\u0027,currency:(/^[A-Za-z]{3}$/.test(cur)?cur:\u0027EUR\u0027),currencyDisplay:\u0027narrowSymbol\u0027})); } catch (e) { return plus + String(v) + \u0027 \u0027 + cur; }\n  }\n  // B.date_short = {from, to} (nur die Mini-App, core.fn_app_screen): ein ISO-Datum im Fenster [from, to) ohne Jahr\n  // (String-Vergleich, die App rechnet kein Datum); Chat/HITL/Cron setzen es nie -\u003e dort immer mit Jahr.\n  const DS = (B.date_short \u0026\u0026 typeof B.date_short.from === \u0027string\u0027 \u0026\u0026 typeof B.date_short.to === \u0027string\u0027) ? B.date_short : null;\n  function date(v) {\n    if (isEmpty(v)) return empty;\n    const m = DS ? /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(v)) : null;\n    if (m \u0026\u0026 String(v) \u003e= DS.from \u0026\u0026 String(v) \u003c DS.to) {\n      try { return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])).toLocaleDateString(loc, { timeZone: \u0027UTC\u0027, month: \u00272-digit\u0027, day: \u00272-digit\u0027 }); }\n      catch (e) { /* weiter mit Jahr */ }\n    }\n    try { return ((m) =\u003e m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])).toLocaleDateString(loc, {timeZone:\u0027UTC\u0027, year:\u0027numeric\u0027, month:\u00272-digit\u0027, day:\u00272-digit\u0027}) : String(v))(/^(\\d{4})-(\\d{2})-(\\d{2})/.exec(String(v))); } catch (e) { return String(v); }\n  }\n  // {kind:\u0027month\u0027, value:\u0027YYYY-MM\u0027} (core.fn_ui_month): 2-stelliger Monat + Jahr im Locale (de „04.2027“), immer mit Jahr.\n  // Aus dem vollen Datum des Locales ohne den Tag gebaut: Intl liefert fuer {month, year} allein in de „04/2027“\n  // (Abnahme 2026-10-31); so folgt der Trenner dem gewohnten Datum (de „04.2027“, en-GB „04/2027“, ko „2027. 04.“).\n  // style \u0027long\u0027 (core.fn_ui_month(d, true)): Monatsname, das Jahr nur ausserhalb des Kurz-Fensters wie bei date()\n  // („Gehen ab im November“ / „… im November 2027“).\n  function month(v, style) {\n    if (isEmpty(v)) return empty;\n    const m = /^(\\d{4})-(\\d{2})$/.exec(String(v));\n    if (!m) return String(v);\n    if (style === \u0027long\u0027) {\n      const short = DS \u0026\u0026 String(v) \u003e= DS.from.slice(0, 7) \u0026\u0026 String(v) \u003c DS.to.slice(0, 7);\n      try { return new Date(Date.UTC(+m[1], +m[2] - 1, 1)).toLocaleDateString(loc, short ? { timeZone: \u0027UTC\u0027, month: \u0027long\u0027 } : { timeZone: \u0027UTC\u0027, month: \u0027long\u0027, year: \u0027numeric\u0027 }); }\n      catch (e) { return String(v); }\n    }\n    try {\n      const parts = new Intl.DateTimeFormat(loc, { timeZone: \u0027UTC\u0027, day: \u00272-digit\u0027, month: \u00272-digit\u0027, year: \u0027numeric\u0027 })\n        .formatToParts(new Date(Date.UTC(+m[1], +m[2] - 1, 1)));\n      const d = parts.findIndex((p) =\u003e p.type === \u0027day\u0027);\n      if (d \u003c 0) return String(v);\n      if (d === 0) parts.splice(0, 2); else parts.splice(d - 1, 2);\n      return parts.map((p) =\u003e p.value).join(\u0027\u0027);\n    } catch (e) { return String(v); }\n  }\n  // Nachkommastellen, die der Wert selbst traegt (ohne Null-Schwanz der DB, z. B. numeric(18,8) \"10.00000000\" -\u003e 0).\n  function decimals(v) {\n    const s = String(v).trim();\n    const e = s.match(/^-?\\d+(?:\\.(\\d+))?e-(\\d+)$/i);\n    if (e) return Math.min(20, (e[1] || \u0027\u0027).length + Number(e[2]));\n    const m = s.match(/\\.(\\d+)$/);\n    return m ? Math.min(20, m[1].replace(/0+$/, \u0027\u0027).length) : 0;\n  }\n  // digits \u003c 0 = so viele Stellen wie der Wert hat (Stueckzahlen: Krypto bis 8 Stellen, nie gerundet).\n  function num(v, digits, sign) {\n    if (isEmpty(v)) return empty;\n    const n = Number(v);\n    if (!isFinite(n)) return String(v);\n    const d = (Number(digits) \u003c 0) ? decimals(v) : Math.max(0, Math.min(6, Number(digits) || 0));\n    try { return n.toLocaleString(loc, { minimumFractionDigits: d, maximumFractionDigits: d, signDisplay: sign ? \u0027exceptZero\u0027 : \u0027auto\u0027 }); }\n    catch (e) { return String(v); }\n  }\n  function val(x) {\n    if (isEmpty(x)) return empty;\n    if (typeof x !== \u0027object\u0027) return String(x);\n    if (Array.isArray(x)) return x.length ? x.map(val).join(\u0027, \u0027) : empty;\n    const v = x.value;\n    switch (x.kind) {\n      case \u0027money\u0027: return money(v, x.currency, x.sign, x.digits);\n      case \u0027date\u0027: return date(v);\n      case \u0027month\u0027: return month(v, x.style);\n      case \u0027number\u0027: return num(v, x.digits, x.sign);\n      case \u0027enum\u0027: {\n        if (isEmpty(v)) return empty;\n        const k = String(x.enum) + \u0027.\u0027 + String(v).toLowerCase().replace(/[^a-z0-9_]+/g, \u0027_\u0027);\n        return has(k) ? T[k] : String(v);\n      }\n      case \u0027bool\u0027: return (v === true || v === \u0027true\u0027) ? t(\u0027core.fmt.yes\u0027)\n        : ((v === false || v === \u0027false\u0027) ? t(\u0027core.fmt.no\u0027) : empty);\n      case \u0027language\u0027: return isEmpty(v) ? empty : (LANGS[v] || String(v));\n      case \u0027key\u0027: return isEmpty(v) ? empty : (has(v) ? T[v] : (x.fallback || String(v)));\n      case \u0027tpl\u0027: return isEmpty(v) ? empty : fill(t(v), x.params);\n      case \u0027removed\u0027: return t(\u0027core.fmt.removed\u0027);\n      case \u0027list\u0027: return (Array.isArray(v) \u0026\u0026 v.length) ? v.map(val).join(\u0027, \u0027) : empty;\n      default: return isEmpty(v) ? empty : (Array.isArray(v) ? v.join(\u0027, \u0027) : String(v));\n    }\n  }\n  function msg(parts) {\n    return (Array.isArray(parts) ? parts : [parts]).filter((p) =\u003e !isEmpty(p)).map(val).join(\u0027 \u0027);\n  }\n  function lines(ls) {\n    return (Array.isArray(ls) ? ls : []).map((l) =\u003e (l === null || l === undefined) ? \u0027\u0027\n      : (Array.isArray(l) ? msg(l) : val(l))).join(\u0027\\n\u0027);\n  }\n  return { T, loc, has, t, empty, isEmpty, fill, money, date, num, val, msg, lines };\n}\nconst ov = JSON.parse($(\u0027Read overview\u0027).item.json.ov || \u0027{}\u0027);\nconst U = uiRender(JSON.parse($(\u0027Read overview\u0027).item.json.ui || \u0027{}\u0027));\nreturn { json: { text: U.msg([ov.msg]), btn: U.t(\u0027core.handoff.btn_go\u0027) } };"
                                     },
