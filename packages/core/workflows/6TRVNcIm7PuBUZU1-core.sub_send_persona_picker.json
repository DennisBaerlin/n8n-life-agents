                                         "operation":  "executeQuery",
                                         "query":  "=SELECT core.fn_ui_text(\u0027core.persona.picker\u0027, y.lang) AS text, core.fn_ui_texts(y.lang, ARRAY[\u0027core.persona.name.neutral\u0027,\u0027core.persona.name.butler\u0027,\u0027core.persona.name.sportscaster\u0027,\u0027core.persona.name.sage\u0027]::text[]) AS t, COALESCE((SELECT pp-\u003e\u003e\u0027persona\u0027 FROM agent.core_contexts c, jsonb_array_elements(COALESCE(c.metadata-\u003e\u0027facts\u0027-\u003e\u0027persons\u0027, \u0027[]\u0027::jsonb)) pp WHERE c.name = \u0027family\u0027 AND pp-\u003e\u003e\u0027person_id\u0027 = ($1::jsonb)-\u003e\u003e\u0027person_id\u0027 LIMIT 1), \u0027neutral\u0027) AS current FROM (SELECT agent.fn_person_lang(($1::jsonb)-\u003e\u003e\u0027person_id\u0027)-\u003e\u003e\u0027lang\u0027 AS lang) y;",
                                         "options":  {
