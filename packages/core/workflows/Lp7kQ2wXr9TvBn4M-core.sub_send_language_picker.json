                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "=SELECT CASE WHEN ($1::jsonb)-\u003e\u003e\u0027mode\u0027 = \u0027self\u0027 THEN (SELECT string_agg(core.fn_ui_text(\u0027core.lang.picker_self\u0027, l.code), E\u0027\\n\u0027 ORDER BY COALESCE(l.code = ($1::jsonb)-\u003e\u003e\u0027suggest\u0027, false) DESC, l.ord) FROM core.ui_languages l) ELSE core.fn_ui_text(\u0027core.lang.picker\u0027, agent.fn_person_lang(agent.fn_resolve_sender(CASE WHEN ($1::jsonb)-\u003e\u003e\u0027chat_id\u0027 ~ \u0027^[0-9]{1,18}$\u0027 THEN (($1::jsonb)-\u003e\u003e\u0027chat_id\u0027)::bigint END)-\u003e\u003e\u0027person_id\u0027)-\u003e\u003e\u0027lang\u0027, jsonb_build_object(\u0027name\u0027, COALESCE((SELECT pp-\u003e\u003e\u0027first_name\u0027 FROM agent.core_contexts c, jsonb_array_elements(COALESCE(c.metadata-\u003e\u0027facts\u0027-\u003e\u0027persons\u0027, \u0027[]\u0027::jsonb)) pp WHERE c.name = \u0027family\u0027 AND pp-\u003e\u003e\u0027person_id\u0027 = ($1::jsonb)-\u003e\u003e\u0027person_id\u0027 LIMIT 1), \u0027?\u0027))) END AS text;",
                                         "options":  {
                                                         "queryReplacement":  "={{ JSON.stringify({ person_id: $(\u0027Start\u0027).item.json.person_id, chat_id: String($(\u0027Start\u0027).item.json.chat_id || \u0027\u0027), mode: String($(\u0027Start\u0027).item.json.mode || \u0027\u0027), suggest: String($(\u0027Start\u0027).item.json.suggest || \u0027\u0027) }) }}"
                                                     }
                                     },
