                      "name":  "Get document",
                      "retryOnFail":  true,
                      "maxTries":  2,
                      "waitBetweenTries":  3000,
                      "credentials":  {
                                          "telegramApi":  {
                                                              "id":  "__CRED_TELEGRAM__",
