                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "=SELECT core.fn_ui_texts(agent.fn_person_lang(agent.fn_resolve_sender(CASE WHEN ($1::jsonb)-\u003e\u003e\u0027chat_id\u0027 ~ \u0027^[0-9]{1,18}$\u0027 THEN (($1::jsonb)-\u003e\u003e\u0027chat_id\u0027)::bigint END)-\u003e\u003e\u0027person_id\u0027)-\u003e\u003e\u0027lang\u0027, ARRAY[\u0027core.cron.drift_check.label\u0027,\u0027core.cron.plan_review.label\u0027,\u0027core.cron.learn_context.label\u0027,\u0027core.cron.onboarding_nudge.label\u0027,\u0027career.cron.score_jobs.label\u0027,\u0027estate.cron.review_register.label\u0027,\u0027estate.cron.remind_case_tasks.label\u0027,\u0027finance.cron.reconcile_accounts.label\u0027,\u0027finance.cron.remind_interest.label\u0027,\u0027finance.cron.remind_pension_statement.label\u0027,\u0027finance.cron.remind_missing_prices.label\u0027,\u0027core.reminders.title\u0027,\u0027core.reminders.intro_owner\u0027,\u0027core.reminders.intro_member\u0027,\u0027core.reminders.state_on\u0027,\u0027core.reminders.state_off\u0027,\u0027core.reminders.mandatory\u0027,\u0027core.reminders.not_installed\u0027,\u0027core.reminders.for_you\u0027,\u0027core.reminders.window\u0027,\u0027core.reminders.monitor_note\u0027,\u0027core.reminders.empty\u0027,\u0027core.reminders.sched_daily\u0027,\u0027core.reminders.sched_weekdays\u0027,\u0027core.reminders.sched_monthly\u0027,\u0027core.reminders.sched_quarterly\u0027,\u0027core.reminders.sched_custom\u0027,\u0027core.reminders.load_failed\u0027]::text[]) AS t, COALESCE((SELECT value FROM core.config WHERE category = \u0027general\u0027 AND key = \u0027reminders_from\u0027), \u002710\u0027) AS win_from, COALESCE((SELECT value FROM core.config WHERE category = \u0027general\u0027 AND key = \u0027reminders_until\u0027), \u002720\u0027) AS win_until;",
                                         "options":  {
                                                         "queryReplacement":  "={{ JSON.stringify({ chat_id: $(\u0027Start\u0027).item.json.chat_id }) }}"
