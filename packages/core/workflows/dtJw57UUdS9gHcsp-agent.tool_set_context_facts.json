                                                                                     "value":  "={{ ({ title: \u0027core.hitl.set_context_facts\u0027, title_params: { context: ({ kind: \u0027key\u0027, value: (((c) =\u003e (c === \u0027family\u0027 ? \u0027core\u0027 : ({\"career_profile\":\"career\",\"career_planning\":\"career\",\"career_preferences\":\"career\",\"finance_profile\":\"finance\"}[c] || \u0027core\u0027)) + \u0027.facts.\u0027 + c + \u0027.\u0027)($(\u0027Start\u0027).item.json.context_name || \u0027family\u0027)) + \u0027title\u0027, fallback: String($(\u0027Start\u0027).item.json.context_name || \u0027?\u0027) }) }, lines: [  ].concat((() =\u003e {\n  const S = $(\u0027Start\u0027).item.json;\n  const pre = (((c) =\u003e (c === \u0027family\u0027 ? \u0027core\u0027 : ({\"career_profile\":\"career\",\"career_planning\":\"career\",\"career_preferences\":\"career\",\"finance_profile\":\"finance\"}[c] || \u0027core\u0027)) + \u0027.facts.\u0027 + c + \u0027.\u0027)($(\u0027Start\u0027).item.json.context_name || \u0027family\u0027));\n  const parse = (s, d) =\u003e { try { return s ? JSON.parse(s) : d; } catch (e) { return d; } };\n  const R = parse($(\u0027Resolve dates\u0027).item.json.facts_resolved, {});\n  const facts = (R \u0026\u0026 typeof R === \u0027object\u0027 \u0026\u0026 !Array.isArray(R)) ? R : {};\n  const persons = Array.isArray(facts.persons) ? facts.persons : [];\n  const hh = (facts.household \u0026\u0026 typeof facts.household === \u0027object\u0027) ? facts.household : {};\n  const ORDER = [\u0027role\u0027, \u0027birth_date\u0027, \u0027employment_status\u0027, \u0027citizenships\u0027, \u0027language\u0027, \u0027persona\u0027];\n  const SKIP = [\u0027person_id\u0027, \u0027first_name\u0027, \u0027last_name\u0027, \u0027as_of\u0027, \u0027_meta\u0027];\n  const human = k =\u003e (k.charAt(0).toUpperCase() + k.slice(1)).replace(/_/g, \u0027 \u0027);\n  const one = it =\u003e {\n    if (it === null || it === undefined) return \u002