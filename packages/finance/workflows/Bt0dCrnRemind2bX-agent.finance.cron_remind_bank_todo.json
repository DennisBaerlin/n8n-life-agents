                                         "query":  "=SELECT core.fn_ui_texts_for(jsonb_strip_nulls(jsonb_build_object(\u0027chat_id\u0027, NULLIF(($1::jsonb)-\u003e\u003e\u0027chat_id\u0027, \u0027\u0027), \u0027keys\u0027, to_jsonb(ARRAY[\u0027finance.bank_todo.intro\u0027,\u0027finance.bank_todo.intro_generic\u0027,\u0027finance.bank_todo.nudge\u0027,\u0027finance.bank_todo.nudge_generic\u0027,\u0027finance.bank_todo.howto\u0027,\u0027finance.bank_todo.btn_done\u0027,\u0027finance.bank_todo.btn_done_generic\u0027,\u0027core.reminders.btn_off\u0027,\u0027core.fmt.empty\u0027,\u0027core.fmt.default_suffix\u0027,\u0027core.fmt.yes\u0027,\u0027core.fmt.no\u0027,\u0027core.fmt.removed\u0027]::text[]), \u0027doc\u0027, ($1::jsonb)-\u003e\u0027msg\u0027-\u003e\u0027group\u0027))) AS ui, ($1::jsonb)-\u003e\u0027msg\u0027 AS msg;",
