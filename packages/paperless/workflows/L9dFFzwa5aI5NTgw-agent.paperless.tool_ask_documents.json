                      "name":  "Ask Paperless",
                      "onError":  "continueRegularOutput",
                      "credentials":  {
                                          "httpHeaderAuth":  {
                                                                 "id":  "__CRED_PAPERLESS_TOKEN__",
                                                                 "name":  "Paperless-NGX API"
                                                             }
