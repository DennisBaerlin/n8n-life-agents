{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Nur das App-Fenster darf die App-Befehle rufen. Das Fragebogen-Fenster zeigt eine Seite des master-Containers und bekommt bewusst keine Rechte.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-startup",
    "allow-check-system",
    "allow-check-docker",
    "allow-fetch-docker",
    "allow-start-docker",
    "allow-wait-docker",
    "allow-start-core",
    "allow-open-wizard",
    "allow-wizard-status",
    "allow-power-info",
    "allow-power-apply",
    "allow-power-answer",
    "allow-power-restore",
    "allow-finish-setup",
    "allow-rollback",
    "allow-uninstall-plan",
    "allow-uninstall-run",
    "allow-error-report",
    "allow-open-link"
  ]
}
