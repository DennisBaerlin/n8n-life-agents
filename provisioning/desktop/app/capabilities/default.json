{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Nur der eigene Inhalt des App-Fensters darf die App-Befehle rufen. Die Fragebogen-Seite des master-Containers laeuft im selben Fenster als fremde Adresse und bekommt ohne remote-Eintrag keine Rechte (Test acl_tests in src/main.rs).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-startup",
    "allow-trash-download",
    "allow-check-system",
    "allow-check-docker",
    "allow-fetch-docker",
    "allow-start-docker",
    "allow-wait-docker",
    "allow-start-core",
    "allow-open-wizard",
    "allow-wizard-status",
    "allow-power-info",
    "allow-power-apply",
    "allow-power-answer",
    "allow-power-restore",
    "allow-finish-setup",
    "allow-rollback",
    "allow-uninstall-plan",
    "allow-uninstall-run",
    "allow-error-report",
    "allow-open-link"
  ]
}
