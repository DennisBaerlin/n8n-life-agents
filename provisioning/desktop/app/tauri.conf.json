{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lifeagents",
  "mainBinaryName": "lifeagents",
  "version": "0.1.0",
  "identifier": "io.lifeagents.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "lifeagents",
        "width": 760,
        "height": 640,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "resources": { "../../compose/compose.yml": "compose.yml" },
    "shortDescription": "Startet deinen eigenen Assistenten auf diesem Rechner",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"]
      }
    }
  }
}
